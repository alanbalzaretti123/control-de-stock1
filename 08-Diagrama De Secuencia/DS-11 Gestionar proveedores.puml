@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-11 Gestionar proveedores.md
title DS-11 — Gestionar proveedores (CU-11)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorGestionarProveedores" as C
participant "cpv:«Singleton» CatalogoProveedores" as CPV
participant "pv:Proveedor" as PV

alt alta de proveedor (camino básico)
  U -> C : altaProveedor(cuit : String, razonSocial : String, telefono : String, email : String, direccion : Direccion)
  activate C
  C -> CPV : buscarProveedor(cuit : String)
  activate CPV
  CPV --> C : «existente : Proveedor»
  deactivate CPV
  alt existente <> null (4.a)
    C --> U : «el CUIT ya está registrado»
  else existente = null
    create participant "nuevo:Proveedor" as N
    C -->> N : create(cuit : String, razonSocial : String, telefono : String, email : String)
    create participant "d:Direccion" as DI
    N -->> DI : create(calle : String, numero : String, codigoPostal : String, localidad : String)
    C -> N : darDeAlta()
    C -> CPV : agregarProveedor(nuevo : Proveedor)
    C --> U : «proveedor registrado»
  end
  deactivate C
else modificar (1.a)
  U -> C : seleccionarProveedor(cuit : String)
  activate C
  C -> CPV : buscarProveedor(cuit : String)
  activate CPV
  CPV --> C : «pv : Proveedor»
  deactivate CPV
  C --> U : «datos del proveedor»
  U -> C : modificarProveedor(razonSocial : String, telefono : String, email : String, direccion : Direccion)
  C -> PV : modificar()
  C --> U : «proveedor actualizado»
  deactivate C
else dar de baja (1.b)
  U -> C : solicitarBaja(cuit : String)
  activate C
  C -> CPV : buscarProveedor(cuit : String)
  activate CPV
  CPV --> C : «pv : Proveedor»
  deactivate CPV
  C -> PV : tieneProductosActivos()
  activate PV
  PV --> C : «tieneProductos : Boolean»
  deactivate PV
  C --> U : «¿confirma la baja? (con advertencia si tiene productos activos)»
  U -> C : confirmarBaja()
  C -> PV : darDeBaja()
  C --> U : «proveedor dado de baja»
  deactivate C
else consultar listado (1.c)
  U -> C : consultarProveedores()
  activate C
  C -> CPV : obtenerProveedoresConProductos()
  activate CPV
  CPV --> C : «proveedores : List<Proveedor>»
  deactivate CPV
  C --> U : «listado de proveedores y sus productos»
  deactivate C
end
@enduml

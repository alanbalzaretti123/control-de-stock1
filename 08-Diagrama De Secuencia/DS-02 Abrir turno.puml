@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-02 Abrir turno.md
title DS-02 — Abrir turno (CU-02)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorAbrirTurno" as C
participant "rt:«Singleton» RegistroTurnos" as RT
participant "usuario:Usuario" as US
participant "tc:Turno" as TC

U -> C : iniciarAperturaTurno()
activate C
C -> RT : buscarTurnoAbierto()
activate RT
RT --> C : «ta : Turno»
deactivate RT
alt ta <> null (1.a)
  C --> U : «debe cerrar el turno abierto antes de abrir uno nuevo»
else ta = null
  C --> U : «solicitar tipo de turno y monto inicial»
  deactivate C
  U -> C : ingresarDatosTurno(tipo : TipoTurno, montoInicial : Real)
  activate C
  alt montoInicial < 0 o no numérico (3.a)
    C --> U : «monto inválido»
  else monto válido
    C -> RT : buscarTurno(fecha : Date, tipo : TipoTurno)
    activate RT
    RT --> C : «tc : Turno»
    deactivate RT
    alt tc = null
      create participant "t:Turno" as T
      C -->> T : create()
      C -> T : abrir(tipo : TipoTurno, montoInicial : Real, usuario : Usuario)
      activate T
      T --> C
      deactivate T
      C -> RT : agregarTurno(t : Turno)
      C --> U : «turno abierto»
    else tc <> null
      C -> US : esEmpleador()
      activate US
      US --> C : «esEmpleador : Boolean»
      deactivate US
      alt esEmpleador = true (3.b)
        C --> U : «el turno ya fue cerrado: ¿desea reabrirlo?»
        deactivate C
        U -> C : confirmarReapertura()
        activate C
        C -> TC : reabrir()
        activate TC
        TC --> C
        deactivate TC
        C --> U : «turno reabierto»
      else esEmpleador = false (3.c)
        C --> U : «solo el empleador puede reabrir el turno»
      end
    end
  end
end
deactivate C
@enduml

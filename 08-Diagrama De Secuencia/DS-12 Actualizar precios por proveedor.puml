@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-12 Actualizar precios por proveedor.md
title DS-12 — Actualizar precios por proveedor (CU-12)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorActualizarPrecios" as C
participant "cp:«Singleton» CatalogoProductos" as CP
participant "«multiobjeto»\nelegidos:Producto" as P

U -> C : seleccionarProveedor(cuit : String)
activate C
C -> CP : buscarProductosActivos(cuit : String)
activate CP
CP --> C : «productos : List<Producto>»
deactivate CP
alt productos está vacía (1.a)
  C --> U : «el proveedor no tiene productos asociados»
else hay productos
  C --> U : «productos con categoría, costo, margen y precio»
  deactivate C
  alt todos los productos (3)
    U -> C : seleccionarTodos()
  else solo una categoría (3.a)
    U -> C : filtrarPorCategoria()
    C --> U : «categorías del proveedor»
    U -> C : seleccionarCategoria(idCategoria : Integer)
  else uno por uno (3.b)
    U -> C : seleccionarManualmente()
    C --> U : «lista de productos para marcar»
    U -> C : marcarProductos(codigos : List<String>)
  end
  activate C
  C --> U : «solicitar porcentaje»
  deactivate C
  U -> C : ingresarPorcentaje(porcentaje : Real)
  activate C
  alt porcentaje = 0, <= −100 o no numérico (5.a)
    C --> U : «porcentaje inválido»
  else porcentaje válido (6)
    loop para cada p en elegidos
      C -> P : calcularPrecioVenta()
      activate P
      P --> C : «nuevoPrecio : Real»
      deactivate P
    end
    note right of C : vista previa con el costo\nsimulado, sin guardar
    C --> U : «vista previa: valores anteriores y nuevos»
    deactivate C
    alt confirma (7 y 8)
      U -> C : confirmarActualizacion()
      activate C
      loop para cada p en elegidos
        C -> P : actualizarCosto(porcentaje : Real)
        activate P
        P -> P : calcularPrecioVenta()
        deactivate P
      end
      C --> U : «precios actualizados»
      deactivate C
    else no confirma (7.a)
      U -> C : cancelar()
      activate C
      C --> U : «sin cambios: volver a la selección»
      deactivate C
    end
  end
end
@enduml

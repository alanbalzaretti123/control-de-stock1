@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-10 Registrar pago a proveedor.md
title DS-10 — Registrar pago a proveedor (CU-10)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorPagoProveedor" as C
participant "cpv:«Singleton» CatalogoProveedores" as CPV
participant "pv:Proveedor" as PV
participant "i:IngresoMercaderia" as I
participant "rt:«Singleton» RegistroTurnos" as RT
participant "t:Turno" as T

U -> C : seleccionarProveedor(cuit : String)
activate C
C -> CPV : buscarProveedor(cuit : String)
activate CPV
CPV --> C : «pv : Proveedor»
deactivate CPV
C -> PV : obtenerIngresosPendientes()
activate PV
PV --> C : «pendientes : List<IngresoMercaderia>»
deactivate PV
alt pendientes no está vacía (2 y 3)
  C --> U : «ingresos con saldo pendiente»
  U -> C : seleccionarIngreso(idIngreso : Integer)
  C -> I : calcularSaldoPendiente()
  activate I
  I --> C : «saldoPendiente : Real»
  deactivate I
else sin pendientes o pago sin ingreso asociado (2.a)
  C --> U : «solicitar concepto»
  U -> C : ingresarConcepto(concepto : String)
end
C --> U : «solicitar medio de pago y monto»
deactivate C

alt un solo medio (5)
  U -> C : ingresarPago(medio : MedioPago, monto : Real)
else pago combinado (5.a)
  U -> C : indicarPagoCombinado()
  C --> U : «solicitar monto de cada medio»
  U -> C : ingresarMontos(montoEfectivo : Real, montoTransferencia : Real)
end
activate C
create participant "pp:PagoProveedor" as PP
C -->> PP : create(pv : Proveedor, i : IngresoMercaderia, medio : MedioPago, monto : Real, usuario : Usuario)
C -> PP : validarMonto(saldoPendiente : Real)
activate PP
PP --> C : «valido : Boolean»
deactivate PP
C -> RT : buscarTurnoAbierto()
activate RT
RT --> C : «t : Turno»
deactivate RT
C -> T : calcularEfectivoEsperado()
activate T
T --> C : «efectivo : Real»
deactivate T

alt valido = false (6.a)
  C --> U : «el monto supera lo adeudado por el ingreso»
else montoEfectivo > efectivo (6.b)
  C --> U : «el efectivo no alcanza: avisar al empleador o dejar pendiente»
else pago válido (6)
  C --> U : «¿confirma el pago?»
  deactivate C
  U -> C : confirmarPago()
  activate C
  loop para cada medio de pago (8)
    C -> PP : registrar()
    create participant "m:MovimientoCaja" as M
    C -->> M : create(PagoProveedor, medio : MedioPago, monto : Real, usuario : Usuario)
    C -> T : registrarMovimiento(m : MovimientoCaja)
  end
  C --> U : «pago registrado y saldo pendiente restante»
end
deactivate C
@enduml

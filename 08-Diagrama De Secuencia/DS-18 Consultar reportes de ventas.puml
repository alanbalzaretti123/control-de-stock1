@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-18 Consultar reportes de ventas.md
title DS-18 — Consultar reportes de ventas (CU-18)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorReportesVentas" as C
participant "rv:«Singleton» RegistroVentas" as RV
participant "«multiobjeto»\nventas:Venta" as MVE
participant "«multiobjeto»\nventas:Venta" as V
participant "«multiobjeto»\nlineas:DetalleVenta" as LV
participant "rt:«Singleton» RegistroTurnos" as RT
participant "«multiobjeto»\nturnos:Turno" as MTU
participant "t:Turno" as T

alt productos más vendidos
  U -> C : reporteMasVendidos(desde : Date, hasta : Date)
  activate C
  C -> RV : buscarVentas(desde : Date, hasta : Date)
  activate RV
  loop para cada v en ventas
    RV -> MVE : getFechaVenta()
    MVE --> RV : «f : DateTime»
  end
  note right of RV : si desde <= f <= hasta\nagregar v a ventas
  RV --> C : «ventas : List<Venta>»
  deactivate RV
  loop para cada v en ventas
    C -> V : estaAnulada()
    activate V
    V --> C : «anulada : Boolean»
    deactivate V
    opt anulada = false
      loop para cada lv en lineas de v
        C -> LV : getProducto()
        activate LV
        LV --> C : «p : Producto»
        C -> LV : getCantidad()
        LV --> C : «cantidad : Real»
        deactivate LV
      end
    end
  end
  note right of C : acumula la cantidad vendida\npor producto y ordena
else cantidad de ventas
  U -> C : reporteCantidadVentas(desde : Date, hasta : Date)
  activate C
  C -> RV : buscarVentas(desde : Date, hasta : Date)
  activate RV
  loop para cada v en ventas
    RV -> MVE : getFechaVenta()
    MVE --> RV : «f : DateTime»
  end
  note right of RV : si desde <= f <= hasta\nagregar v a ventas
  RV --> C : «ventas : List<Venta>»
  deactivate RV
  loop para cada v en ventas
    C -> V : estaAnulada()
    activate V
    V --> C : «anulada : Boolean»
    deactivate V
  end
  note right of C : cuenta las ventas no anuladas
else total vendido por turno
  U -> C : reporteTotalPorTurno(fecha : Date, tipoTurno : Char)
  note right of U : tipoTurno: 'M' = mañana, 'T' = tarde\n(el controlador lo convierte a TipoTurno)
  activate C
  C -> RT : buscarTurno(fecha : Date, tipo : TipoTurno)
  activate RT
  loop para cada t en turnos
    RT -> MTU : getFechaTurno()
    MTU --> RT : «f : Date»
    RT -> MTU : getTipoTurno()
    MTU --> RT : «tt : TipoTurno»
  end
  note right of RT : si f = fecha y tt = tipo\nt = turnos[i]\ncortar iteración
  RT --> C : «t : Turno»
  deactivate RT
  C -> T : calcularTotalVendido()
  activate T
  T --> C : «total : Real»
  deactivate T
end

alt no hay datos para el filtro (2.a)
  C --> U : «no hay datos para el período seleccionado»
else hay datos (2)
  C --> U : «reporte»
  opt pide imprimir (2.b)
    U -> C : imprimirReporte()
    C --> U : «documento imprimible»
  end
end
deactivate C
@enduml

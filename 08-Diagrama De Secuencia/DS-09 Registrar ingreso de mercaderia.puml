@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-09 Registrar ingreso de mercaderia.md
title DS-09 — Registrar ingreso de mercadería (CU-09)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorIngresoMercaderia" as C
participant "cpv:«Singleton» CatalogoProveedores" as CPV
participant "cp:«Singleton» CatalogoProductos" as CP
participant "p:Producto" as P
participant "ri:«Singleton» RegistroIngresos" as RI

U -> C : crearNuevoIngreso(cuit : String, numeroRemito : String)
activate C
C -> CPV : buscarProveedor(cuit : String)
activate CPV
CPV --> C : «pv : Proveedor»
deactivate CPV
create participant "i:IngresoMercaderia" as I
C -->> I : create(pv : Proveedor, numeroRemito : String, usuario : Usuario)
C --> U
deactivate C

loop más productos recibidos
  U -> C : introducirProducto(codigo : String, cantidad : Real)
  activate C
  C -> CP : buscarProducto(codigo : String)
  activate CP
  CP --> C : «p : Producto»
  deactivate CP
  C -> I : agregarProducto(p : Producto, cantidad : Real)
  activate I
  create participant "di:DetalleIngreso" as DI
  I -->> DI : create(p : Producto, cantidad : Real)
  participant "«multiobjeto»\ndetalles:DetalleIngreso" as DS
  I -> DS : add(di : DetalleIngreso)
  I --> C
  deactivate I
  C --> U : «línea agregada»
  deactivate C
end

U -> C : finalizarIngreso(montoTotal : Real)
activate C
C --> U : «resumen del ingreso: ¿confirma?»
deactivate C
U -> C : confirmarIngreso()
activate C
C -> I : registrar()
activate I
loop para cada di en detalles
  I -> P : reponerStock(cantidad : Real)
end
I --> C
deactivate I
C -> RI : agregarIngreso(i : IngresoMercaderia)
C --> U : «ingreso registrado: ¿paga en el momento?»
deactivate C

alt el pago se realiza en el momento (5 y 6)
  U -> C : pagarEnElMomento()
  ref over U, C : DS-10 Registrar pago a proveedor (para el ingreso i)
else el pago queda pendiente (5.a)
  U -> C : dejarPagoPendiente()
  activate C
  C -> I : calcularSaldoPendiente()
  activate I
  I --> C : «saldo : Real»
  deactivate I
  C --> U : «ingreso con pago pendiente»
  deactivate C
end
@enduml

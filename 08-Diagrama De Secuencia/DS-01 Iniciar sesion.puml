@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-01 Iniciar sesion.md
title DS-01 — Iniciar sesión (CU-01)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorIniciarSesion" as C
participant "cu:«Singleton» CatalogoUsuarios" as CU
participant "u:Usuario" as US

U -> C : iniciarSesion(nombreUsuario : String, contraseña : String)
activate C
C -> CU : buscarUsuario(nombreUsuario : String)
activate CU
CU --> C : «u : Usuario»
deactivate CU
alt u = null (2.a)
  C --> U : «credenciales incorrectas»
else u <> null
  C -> US : iniciarSesion(contraseña : String)
  activate US
  US --> C : «valida : Boolean»
  deactivate US
  C -> US : getEstadoUsuario()
  activate US
  US --> C : «estado : EstadoRegistro»
  deactivate US
  alt valida = false (2.a)
    C --> U : «credenciales incorrectas»
  else estado = Inactivo (2.b)
    C --> U : «usuario dado de baja: contactar al empleador»
  else valida y estado = Activo
    C -> US : esEmpleador()
    activate US
    US --> C : «esEmpleador : Boolean»
    deactivate US
    C --> U : «funcionalidades habilitadas según el rol»
  end
end
deactivate C
@enduml

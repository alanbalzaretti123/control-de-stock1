@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-19 Consultar balance de caja.md
title DS-19 — Consultar balance de caja (CU-19)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorBalanceCaja" as C
participant "rt:«Singleton» RegistroTurnos" as RT
participant "«multiobjeto»\nturnos:Turno" as T
participant "«multiobjeto»\nmovimientos:MovimientoCaja" as M
participant "usuario:Usuario" as US
participant "rv:«Singleton» RegistroVentas" as RV
participant "«multiobjeto»\nventas:Venta" as V

U -> C : consultarBalance(desde : Date, hasta : Date, tipo : TipoTurno)
activate C
C -> RT : buscarTurnos(desde : Date, hasta : Date, tipo : TipoTurno)
activate RT
RT --> C : «turnos : List<Turno>»
deactivate RT
alt turnos está vacía (1.a)
  C --> U : «no hay movimientos en el período seleccionado»
else hay turnos (2)
  loop para cada t en turnos
    C -> T : calcularTotalVendido()
    activate T
    T --> C : «totalVendido : Real»
    C -> T : calcularEfectivoEsperado()
    loop para cada m en movimientos de t
      T -> M : esEfectivo()
      T -> M : esEntrada()
    end
    T --> C : «esperado : Real»
    C -> T : calcularDiferencia()
    T --> C : «diferencia : Real»
    deactivate T
  end
  C -> US : esEmpleador()
  activate US
  US --> C : «esEmpleador : Boolean»
  deactivate US
  opt esEmpleador = true (2.a)
    C -> RV : buscarVentas(desde : Date, hasta : Date)
    activate RV
    RV --> C : «ventas : List<Venta>»
    deactivate RV
    loop para cada v no anulada en ventas
      C -> V : calcularGananciaBruta()
      activate V
      V --> C : «ganancia : Real»
      deactivate V
    end
  end
  C --> U : «balance: monto inicial, ventas, entradas y salidas,\nesperado, contado, diferencia y detalle»
  opt el empleador pide imprimir (2.b)
    U -> C : imprimirBalance()
    C --> U : «documento imprimible»
  end
end
deactivate C
@enduml

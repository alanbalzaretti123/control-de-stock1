@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-19 Consultar balance de caja.md
title DS-19 — Consultar balance de caja (CU-19)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Empleado / Empleador" as U
boundary ":PantallaBalance" as P
control ":GestorBalance" as G
entity ":Usuario" as US
entity ":Turno" as T
entity ":MovimientoCaja" as M
entity ":Venta" as V

U -> P : seleccionarPeriodo(fecha y turno, o rango de días)
activate P
P -> G : generarBalance(periodo, usuario)
activate G
G -> G : buscarTurnos(periodo)

alt no hay operaciones en el período (1.a)
  G --> P : sin movimientos
  P --> U : mostrarMensaje("No hay movimientos en el período seleccionado")
else hay turnos con operaciones
  loop por cada turno del período
    G -> T : calcularTotalVendido()
    T --> G : total de ventas
    G -> T : calcularEfectivoEsperado()
    activate T
    loop por cada movimiento del turno
      T -> M : esEfectivo()
      T -> M : esEntrada()
    end
    T --> G : efectivo esperado
    deactivate T
    G -> T : calcularDiferencia()
    T --> G : diferencia de caja
  end

  G -> US : esEmpleador()
  activate US
  US --> G : rol
  deactivate US
  opt el usuario es Empleador (2.a)
    loop por cada venta no anulada del período
      G -> V : calcularGananciaBruta()
      V --> G : ganancia
    end
  end

  G --> P : balance
  P --> U : mostrarBalance(monto inicial, ventas, entradas y salidas,\nesperado, contado, diferencia, detalle de operaciones)

  opt el empleador pide imprimir (2.b)
    U -> P : imprimirBalance()
    P -> G : generarDocumento()
    G --> P : documento imprimible
    P --> U : mostrarDocumento()
  end
end

deactivate G
deactivate P
@enduml

@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-06 Anular venta.md
title DS-06 — Anular venta (CU-06)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorAnularVenta" as C
participant "rv:«Singleton» RegistroVentas" as RV
participant "v:Venta" as V
participant "c:Cliente" as CL
participant "p:Producto" as P
participant "rt:«Singleton» RegistroTurnos" as RT
participant "t:Turno" as T

U -> C : anularVenta(numeroComprobante : Integer)
activate C
C -> RV : buscarVenta(numeroComprobante : Integer)
activate RV
RV --> C : «v : Venta»
deactivate RV
alt v = null (1.a)
  C --> U : «la venta no existe»
else v <> null
  C -> V : estaAnulada()
  activate V
  V --> C : «anulada : Boolean»
  deactivate V
  alt anulada = true (2.a)
    C --> U : «la venta ya fue anulada»
  else venta fiada y saldo del cliente < total (2.b)
    C -> CL : calcularSaldo()
    activate CL
    CL --> C : «saldo : Real»
    deactivate CL
    C --> U : «no puede anularse: el cliente ya pagó parte»
  else se puede anular
    C --> U : «detalle de la venta»
    deactivate C
    U -> C : confirmarAnulacion(motivo : String)
    activate C
    C -> V : anular(usuario : Usuario, motivo : String)
    activate V
    loop para cada lv en lineas
      V -> P : reponerStock(cantidad : Real)
    end
    V --> C
    deactivate V
    alt venta de contado (4)
      C -> RT : buscarTurnoAbierto()
      activate RT
      RT --> C : «t : Turno»
      deactivate RT
      loop para cada medio de pago de la venta
        create participant "m:MovimientoCaja" as M
        C -->> M : create(Anulacion, medio : MedioPago, monto : Real, usuario : Usuario)
        C -> T : registrarMovimiento(m : MovimientoCaja)
      end
    else venta fiada (4.a)
      C -> CL : descontarDeuda(total : Real)
    end
    C --> U : «venta anulada»
  end
end
deactivate C
@enduml

@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-16 Consultar stock y precios.md
title DS-16 — Consultar stock y precios (CU-16)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorConsultarStock" as C
participant "cp:«Singleton» CatalogoProductos" as CP
participant "«multiobjeto»\nencontrados:Producto" as P
participant "usuario:Usuario" as US

U -> C : consultarProductos(texto : String)
activate C
C -> CP : buscarProductos(texto : String)
activate CP
CP --> C : «encontrados : List<Producto>»
deactivate CP
alt encontrados está vacía (1.a)
  C --> U : «no se encontraron productos»
else hay productos (2)
  loop para cada p en encontrados
    C -> P : requiereReposicion()
    activate P
    P --> C : «bajoMinimo : Boolean»
    deactivate P
  end
  C -> US : esEmpleador()
  activate US
  US --> C : «esEmpleador : Boolean»
  deactivate US
  alt esEmpleador = true (2.a)
    loop para cada p en encontrados
      C -> P : getPrecioCosto()
      activate P
      P --> C : «costo : Real»
      deactivate P
    end
    C --> U : «listado con precio de costo y marca de bajo mínimo»
  else esEmpleador = false
    C --> U : «listado sin precio de costo, con marca de bajo mínimo»
  end
  opt el empleador pide imprimir (2.b)
    U -> C : imprimirListado()
    C --> U : «documento imprimible»
  end
end
deactivate C
@enduml

@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-16 Consultar stock y precios.md
title DS-16 — Consultar stock y precios (CU-16)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Empleado / Empleador" as U
boundary ":PantallaStock" as P
control ":GestorStock" as G
entity ":Usuario" as US
entity ":Producto" as PR

U -> P : consultarProductos(textoBusqueda)
activate P
P -> G : buscarProductos(textoBusqueda, usuario)
activate G
G -> G : buscarProductos(textoBusqueda)

alt no se encuentran productos (1.a)
  G --> P : sin resultados
  P --> U : mostrarMensaje("No se encontraron productos")
else hay productos
  loop por cada producto encontrado
    G -> PR : requiereReposicion()
    activate PR
    PR --> G : Boolean
    deactivate PR
  end
  G -> US : esEmpleador()
  activate US
  US --> G : rol
  deactivate US
  alt el usuario es Empleador (2.a)
    G --> P : productos con precio de costo
  else el usuario es Empleado
    G --> P : productos sin precio de costo
  end
  P --> U : mostrarListado(código, nombre, precio, stock, marca de bajo mínimo)

  opt el empleador pide imprimir (2.b)
    U -> P : imprimirListado()
    P -> G : generarDocumento()
    G --> P : documento imprimible
    P --> U : mostrarDocumento()
  end
end

deactivate G
deactivate P
@enduml

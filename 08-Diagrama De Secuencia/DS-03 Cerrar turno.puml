@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-03 Cerrar turno.md
title DS-03 — Cerrar turno (CU-03)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorCerrarTurno" as C
participant "rt:«Singleton» RegistroTurnos" as RT
participant "t:Turno" as T
participant "«multiobjeto»\nmovimientos:MovimientoCaja" as M

U -> C : iniciarCierreTurno()
activate C
C -> RT : buscarTurnoAbierto()
activate RT
RT --> C : «t : Turno»
deactivate RT
C --> U : «solicitar efectivo contado»
note right of C : no se muestra el efectivo\nesperado (arqueo ciego)
deactivate C

U -> C : ingresarEfectivoContado(montoContado : Real)
activate C
alt montoContado < 0 o no numérico (3.a)
  C --> U : «monto inválido»
else monto válido
  C -> T : cerrar(montoContado : Real)
  activate T
  T -> T : calcularEfectivoEsperado()
  loop para cada m en movimientos
    T -> M : esEfectivo()
    activate M
    M --> T : «Boolean»
    T -> M : esEntrada()
    M --> T : «Boolean»
    deactivate M
  end
  note right of T : esperado = montoInicial\n+ entradas en efectivo\n− salidas en efectivo
  T -> T : calcularDiferencia()
  note right of T : diferencia = contado − esperado
  T --> C
  deactivate T
  C --> U : «resumen: monto inicial, entradas y salidas,\nesperado, contado y diferencia»
end
deactivate C
@enduml

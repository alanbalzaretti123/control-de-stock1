@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-15 Gestionar usuarios.md
title DS-15 — Gestionar usuarios (CU-15)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Empleador" as U
boundary ":PantallaUsuarios" as P
control ":GestorUsuarios" as G
entity ":Usuario" as US

alt alta de usuario (camino básico)
  U -> P : solicitarAltaUsuario()
  activate P
  P --> U : solicitarDatos(nombreUsuario, nombreCompleto, rol, contraseña)
  U -> P : ingresarDatos(datos)
  P -> G : darDeAltaUsuario(datos)
  activate G
  G -> G : buscarUsuario(nombreUsuario)
  alt el nombre de usuario ya existe (4.a)
    G --> P : usuario existente
    P --> U : mostrarMensaje("El nombre de usuario ya existe")
  else nombre nuevo
    create entity "nuevo:Usuario" as N
    G -> N : darDeAlta()
    G --> P : usuario registrado (activo)
    P --> U : mostrarConfirmación()
  end
  deactivate G
  deactivate P

else modificar usuario (1.a)
  U -> P : seleccionarUsuario(usuario)
  activate P
  P --> U : mostrarDatos(nombreCompleto, rol)
  U -> P : ingresarNuevosDatos(nombreCompleto, rol)
  P -> G : modificarUsuario(usuario, nombreCompleto, rol)
  activate G
  G -> G : verificarEmpleadorActivo()
  alt quedaría sin ningún empleador activo (1.a.2.a)
    G --> P : cambio no permitido
    P --> U : mostrarMensaje("Debe existir al menos un empleador activo")
  else cambio permitido
    G -> US : modificar(nombreCompleto, rol)
    G --> P : usuario actualizado
    P --> U : mostrarConfirmación()
  end
  deactivate G
  deactivate P

else restablecer contraseña (1.b)
  U -> P : solicitarRestablecerContraseña(usuario)
  activate P
  P --> U : solicitarNuevaContraseña()
  U -> P : ingresarNuevaContraseña(contraseña)
  P -> G : restablecerContraseña(usuario, contraseña)
  activate G
  G -> US : restablecerContraseña(contraseña)
  G --> P : contraseña actualizada
  deactivate G
  P --> U : mostrarConfirmación()
  deactivate P

else dar de baja (1.c)
  U -> P : solicitarBaja(usuario)
  activate P
  P --> U : solicitarConfirmación()
  U -> P : confirmar()
  P -> G : darDeBaja(usuario)
  activate G
  G -> G : verificarEmpleadorActivo()
  alt quedaría sin ningún empleador activo (1.c.2.a)
    G --> P : baja no permitida
    P --> U : mostrarMensaje("Debe existir al menos un empleador activo")
  else baja permitida
    G -> US : darDeBaja()
    G --> P : usuario inactivo
    P --> U : mostrarConfirmación()
  end
  deactivate G
  deactivate P

else reactivar (1.d)
  U -> P : solicitarReactivacion(usuario)
  activate P
  P -> G : reactivar(usuario)
  activate G
  G -> US : reactivar()
  G --> P : usuario activo
  deactivate G
  P --> U : mostrarConfirmación()
  deactivate P
end
@enduml

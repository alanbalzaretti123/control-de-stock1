@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-15 Gestionar usuarios.md
title DS-15 — Gestionar usuarios (CU-15)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorGestionarUsuarios" as C
participant "cu:«Singleton» CatalogoUsuarios" as CU
participant "«multiobjeto»\nusuarios:Usuario" as MUS
participant "u:Usuario" as US

alt alta de usuario (camino básico)
  U -> C : altaUsuario(nombreUsuario : String, nombreCompleto : String, rol : Char, contraseña : String)
  note right of U : rol: 'D' = empleador, 'E' = empleado\n(el controlador lo convierte a RolUsuario)
  activate C
  C -> CU : buscarUsuario(nombreUsuario : String)
  activate CU
  loop para cada u en usuarios
    CU -> MUS : getNombreUsuario()
    MUS --> CU : «nombre : String»
  end
  note right of CU : si nombre = nombreUsuario\nexistente = usuarios[i]\ncortar iteración
  CU --> C : «existente : Usuario»
  deactivate CU
  alt existente <> null (4.a)
    C --> U : «el nombre de usuario ya existe»
  else existente = null
    create participant "nuevo:Usuario" as N
    C -->> N : create(nombreUsuario : String, nombreCompleto : String, rol : RolUsuario, contraseña : String)
    C -> N : darDeAlta()
    C -> MUS : add(nuevo : Usuario)
    C --> U : «usuario registrado (activo)»
  end
  deactivate C
else modificar (1.a)
  U -> C : seleccionarUsuario(nombreUsuario : String)
  activate C
  C -> CU : buscarUsuario(nombreUsuario : String)
  activate CU
  loop para cada u en usuarios
    CU -> MUS : getNombreUsuario()
    MUS --> CU : «nombre : String»
  end
  note right of CU : si nombre = nombreUsuario\nu = usuarios[i]\ncortar iteración
  CU --> C : «u : Usuario»
  deactivate CU
  C --> U : «nombre completo y rol»
  U -> C : modificarUsuario(nombreCompleto : String, rol : Char)
  note right of U : rol: 'D' = empleador, 'E' = empleado\n(el controlador lo convierte a RolUsuario)
  C -> CU : contarEmpleadoresActivos()
  activate CU
  loop para cada u en usuarios
    CU -> MUS : esEmpleador()
    MUS --> CU : «esEmpleador : Boolean»
    CU -> MUS : getEstadoUsuario()
    MUS --> CU : «estado : EstadoRegistro»
  end
  note right of CU : si esEmpleador = true y estado = Activo\ncantidad = cantidad + 1
  CU --> C : «cantidad : Integer»
  deactivate CU
  alt el cambio deja sin empleadores activos (1.a.2.a)
    C --> U : «debe existir al menos un empleador activo»
  else cambio permitido
    C -> US : modificar(nombreCompleto : String, rol : RolUsuario)
    C --> U : «usuario actualizado»
  end
  deactivate C
else restablecer contraseña (1.b)
  U -> C : solicitarRestablecerContraseña(nombreUsuario : String)
  activate C
  C -> CU : buscarUsuario(nombreUsuario : String)
  activate CU
  loop para cada u en usuarios
    CU -> MUS : getNombreUsuario()
    MUS --> CU : «nombre : String»
  end
  note right of CU : si nombre = nombreUsuario\nu = usuarios[i]\ncortar iteración
  CU --> C : «u : Usuario»
  deactivate CU
  C --> U : «solicitar nueva contraseña»
  U -> C : ingresarNuevaContraseña(contraseña : String)
  C -> US : restablecerContraseña(contraseña : String)
  C --> U : «contraseña actualizada»
  deactivate C
else dar de baja (1.c)
  U -> C : solicitarBaja(nombreUsuario : String)
  activate C
  C -> CU : buscarUsuario(nombreUsuario : String)
  activate CU
  loop para cada u en usuarios
    CU -> MUS : getNombreUsuario()
    MUS --> CU : «nombre : String»
  end
  note right of CU : si nombre = nombreUsuario\nu = usuarios[i]\ncortar iteración
  CU --> C : «u : Usuario»
  deactivate CU
  C --> U : «¿confirma la baja?»
  U -> C : confirmarBaja()
  C -> CU : contarEmpleadoresActivos()
  activate CU
  loop para cada u en usuarios
    CU -> MUS : esEmpleador()
    MUS --> CU : «esEmpleador : Boolean»
    CU -> MUS : getEstadoUsuario()
    MUS --> CU : «estado : EstadoRegistro»
  end
  note right of CU : si esEmpleador = true y estado = Activo\ncantidad = cantidad + 1
  CU --> C : «cantidad : Integer»
  deactivate CU
  alt u es el único empleador activo (1.c.2.a)
    C --> U : «debe existir al menos un empleador activo»
  else baja permitida
    C -> US : darDeBaja()
    C --> U : «usuario dado de baja»
  end
  deactivate C
else reactivar (1.d)
  U -> C : reactivarUsuario(nombreUsuario : String)
  activate C
  C -> CU : buscarUsuario(nombreUsuario : String)
  activate CU
  loop para cada u en usuarios
    CU -> MUS : getNombreUsuario()
    MUS --> CU : «nombre : String»
  end
  note right of CU : si nombre = nombreUsuario\nu = usuarios[i]\ncortar iteración
  CU --> C : «u : Usuario»
  deactivate CU
  C -> US : reactivar()
  C --> U : «usuario activo»
  deactivate C
end
@enduml

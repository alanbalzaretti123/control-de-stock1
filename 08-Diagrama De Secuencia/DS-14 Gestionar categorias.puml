@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-14 Gestionar categorias.md
title DS-14 — Gestionar categorías (CU-14)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorGestionarCategorias" as C
participant "ccat:«Singleton» CatalogoCategorias" as CCAT
participant "cat:Categoria" as CA

alt alta de categoría (camino básico)
  U -> C : altaCategoria(nombre : String, descripcion : String)
  activate C
  C -> CCAT : buscarCategoria(nombre : String)
  activate CCAT
  CCAT --> C : «existente : Categoria»
  deactivate CCAT
  alt existente <> null (4.a)
    C --> U : «la categoría ya existe»
  else existente = null
    create participant "nueva:Categoria" as N
    C -->> N : create(nombre : String, descripcion : String)
    C -> N : darDeAlta()
    C -> CCAT : agregarCategoria(nueva : Categoria)
    C --> U : «categoría registrada»
  end
  deactivate C
else modificar (1.a)
  U -> C : seleccionarCategoria(idCategoria : Integer)
  activate C
  C -> CCAT : buscarCategoria(idCategoria : Integer)
  activate CCAT
  CCAT --> C : «cat : Categoria»
  deactivate CCAT
  C --> U : «datos de la categoría»
  U -> C : modificarCategoria(nombre : String, descripcion : String)
  C -> CA : modificar(nombre : String, descripcion : String)
  C --> U : «categoría actualizada»
  deactivate C
else eliminar (1.b)
  U -> C : solicitarEliminacion(idCategoria : Integer)
  activate C
  C -> CCAT : buscarCategoria(idCategoria : Integer)
  activate CCAT
  CCAT --> C : «cat : Categoria»
  deactivate CCAT
  C -> CA : tieneProductos()
  activate CA
  CA --> C : «tieneProductos : Boolean»
  deactivate CA
  alt tieneProductos = true (1.b.1.a)
    C --> U : «no se puede eliminar: tiene productos asociados»
  else tieneProductos = false
    C --> U : «¿confirma la eliminación?»
    U -> C : confirmarEliminacion()
    C -> CA : eliminar()
    C -> CCAT : quitarCategoria(cat : Categoria)
    C --> U : «categoría eliminada»
  end
  deactivate C
end
@enduml

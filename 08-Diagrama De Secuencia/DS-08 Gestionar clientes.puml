@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-08 Gestionar clientes.md
title DS-08 — Gestionar clientes (CU-08)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorGestionarClientes" as C
participant "cc:«Singleton» CatalogoClientes" as CC
participant "c:Cliente" as CL

alt alta de cliente (camino básico)
  U -> C : altaCliente(nombre : String, apellido : String, telefono : String)
  activate C
  C -> CC : buscarCliente(nombre : String, apellido : String)
  activate CC
  CC --> C : «existente : Cliente»
  deactivate CC
  opt existente <> null (3.a)
    C --> U : «ya existe un cliente con ese nombre»
    U -> C : confirmarOtraPersona()
  end
  create participant "nuevo:Cliente" as N
  C -->> N : create(nombre : String, apellido : String, telefono : String)
  C -> N : darDeAlta()
  note right of N : habilitado para fiado\ny saldo en cero
  C -> CC : agregarCliente(nuevo : Cliente)
  C --> U : «cliente registrado»
  deactivate C
else modificar datos — solo Empleador (1.a)
  U -> C : seleccionarCliente(idCliente : Integer)
  activate C
  C -> CC : buscarCliente(idCliente : Integer)
  activate CC
  CC --> C : «c : Cliente»
  deactivate CC
  C --> U : «datos del cliente»
  U -> C : modificarCliente(nombre : String, apellido : String, telefono : String)
  C -> CL : modificar(nombre : String, apellido : String, telefono : String)
  C --> U : «cliente actualizado»
  deactivate C
else habilitar o inhabilitar — solo Empleador (1.b)
  U -> C : seleccionarCliente(idCliente : Integer)
  activate C
  C -> CC : buscarCliente(idCliente : Integer)
  activate CC
  CC --> C : «c : Cliente»
  deactivate CC
  C -> CL : calcularSaldo()
  activate CL
  CL --> C : «saldo : Real»
  deactivate CL
  C --> U : «estado y saldo: ¿confirma el cambio?»
  U -> C : confirmarCambioEstado()
  C -> CL : estaHabilitado()
  activate CL
  CL --> C : «habilitado : Boolean»
  deactivate CL
  alt habilitado = true
    C -> CL : inhabilitar()
  else habilitado = false
    C -> CL : habilitar()
  end
  C --> U : «estado actualizado»
  deactivate C
else consultar cuenta corriente — solo Empleador (1.c)
  U -> C : consultarCuentaCorriente(idCliente : Integer)
  activate C
  C -> CC : buscarCliente(idCliente : Integer)
  activate CC
  CC --> C : «c : Cliente»
  deactivate CC
  C -> CL : consultarCuentaCorriente()
  activate CL
  CL --> C : «ventas fiadas y pagos»
  C -> CL : calcularSaldo()
  CL --> C : «saldo : Real»
  deactivate CL
  C --> U : «saldo y movimientos ordenados por fecha»
  deactivate C
end
@enduml

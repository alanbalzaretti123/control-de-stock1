@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-13 Gestionar productos.md
title DS-13 — Gestionar productos (CU-13)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleador:Empleador" as U
participant "ctrl:ControladorGestionarProductos" as C
participant "cp:«Singleton» CatalogoProductos" as CP
participant "ccat:«Singleton» CatalogoCategorias" as CCAT
participant "cpv:«Singleton» CatalogoProveedores" as CPV
participant "p:Producto" as P

alt alta de producto (camino básico)
  U -> C : altaProducto(codigo : String, nombre : String, idCategoria : Integer, cuit : String,\nunidad : UnidadMedida, costo : Real, margen : Real, stockInicial : Real, stockMinimo : Real)
  activate C
  C -> CCAT : buscarCategoria(idCategoria : Integer)
  activate CCAT
  CCAT --> C : «cat : Categoria»
  deactivate CCAT
  C -> CPV : buscarProveedor(cuit : String)
  activate CPV
  CPV --> C : «pv : Proveedor»
  deactivate CPV
  create participant "nuevo:Producto" as N
  C -->> N : create(codigo, nombre, cat, pv, unidad, costo, margen, stockInicial, stockMinimo)
  C -> N : calcularPrecioVenta()
  activate N
  N --> C : «precioVenta : Real»
  deactivate N
  note right of N : precio = costo * (1 + margen / 100)\nredondeado al múltiplo de $10 superior
  C --> U : «precio de venta calculado: ¿confirma?»
  deactivate C
  opt ajusta el precio a mano (5.a)
    U -> C : ajustarPrecio(precio : Real)
    activate C
    C -> N : ajustarPrecioVenta(precio : Real)
    note right of N : recalcula el margen
    opt precio < costo (5.b)
      C --> U : «advertencia: venta a pérdida»
    end
    C --> U : «nuevo margen: ¿confirma?»
    deactivate C
  end
  U -> C : confirmarAlta()
  activate C
  C -> CP : buscarProducto(codigo : String)
  activate CP
  CP --> C : «existente : Producto»
  deactivate CP
  alt existente <> null (6.a)
    C --> U : «el código ya existe»
  else existente = null (6)
    C -> N : darDeAlta()
    C -> CP : agregarProducto(nuevo : Producto)
    C --> U : «producto registrado»
  end
  deactivate C
else modificar (1.a)
  U -> C : seleccionarProducto(codigo : String)
  activate C
  C -> CP : buscarProducto(codigo : String)
  activate CP
  CP --> C : «p : Producto»
  deactivate CP
  C --> U : «datos actuales»
  U -> C : ingresarNuevosValores(costo : Real, margen : Real, stockActual : Real)
  opt cambió el costo o el margen
    C -> P : modificarMargen(margen : Real)
    C -> P : calcularPrecioVenta()
    activate P
    P --> C : «precioVenta : Real»
    deactivate P
  end
  opt corrigió el stock
    C -> P : corregirStock(cantidad : Real)
  end
  C --> U : «datos resultantes: ¿confirma?»
  U -> C : confirmarModificacion()
  C -> P : modificar()
  C --> U : «producto actualizado»
  deactivate C
else dar de baja (1.b)
  U -> C : solicitarBaja(codigo : String)
  activate C
  C -> CP : buscarProducto(codigo : String)
  activate CP
  CP --> C : «p : Producto»
  deactivate CP
  C --> U : «¿confirma la baja?»
  U -> C : confirmarBaja()
  C -> P : darDeBaja()
  note right of P : queda inactivo, sin borrarse\ndel historial de ventas
  C --> U : «producto dado de baja»
  deactivate C
end
@enduml

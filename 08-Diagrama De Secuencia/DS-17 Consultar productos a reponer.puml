@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-17 Consultar productos a reponer.md
title DS-17 — Consultar productos a reponer (CU-17)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorProductosAReponer" as C
participant "cp:«Singleton» CatalogoProductos" as CP
participant "«multiobjeto»\nactivos:Producto" as P

U -> C : consultarProductosAReponer(cuit : String, idCategoria : Integer)
activate C
C -> CP : buscarProductosActivos(cuit : String, idCategoria : Integer)
activate CP
CP --> C : «activos : List<Producto>»
deactivate CP
loop para cada p en activos
  C -> P : requiereReposicion()
  activate P
  P --> C : «aReponer : Boolean»
  deactivate P
end
note right of C : requiere reposición si\nstockActual <= stockMinimo
alt ningún producto a reponer (2.a)
  C --> U : «no hay productos a reponer»
else hay productos a reponer (2)
  C -> C : agruparPorProveedor()
  C --> U : «lista: nombre, stock actual, stock mínimo y unidad»
  opt pide imprimir (2.b)
    U -> C : imprimirLista()
    C --> U : «documento imprimible»
  end
end
deactivate C
@enduml

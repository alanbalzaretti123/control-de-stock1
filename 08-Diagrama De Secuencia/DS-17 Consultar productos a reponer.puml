@startuml
title DS-17 — Consultar productos a reponer (CU-17)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor "Empleado / Empleador" as U
boundary ":PantallaReposicion" as P
control ":GestorStock" as G
entity ":Producto" as PR

U -> P : consultarReposicion(proveedor, categoria)
activate P
P -> G : obtenerProductosAReponer(proveedor, categoria)
activate G
G -> G : buscarProductosActivos(proveedor, categoria)
loop por cada producto activo
  G -> PR : requiereReposicion()
  activate PR
  PR --> G : Boolean
  deactivate PR
end

alt no hay productos a reponer (2.a)
  G --> P : lista vacía
  P --> U : mostrarMensaje("No hay productos a reponer")
else hay productos a reponer
  G -> G : agruparPorProveedor()
  G --> P : productos a reponer
  P --> U : mostrarLista(nombre, stock actual, stock mínimo, unidad)
  opt el usuario pide imprimir (2.b)
    U -> P : imprimirLista()
    P -> G : generarDocumento()
    G --> P : documento imprimible
    P --> U : mostrarDocumento()
  end
end

deactivate G
deactivate P
@enduml

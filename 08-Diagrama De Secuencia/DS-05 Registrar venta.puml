@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-05 Registrar venta.md
title DS-05 — Registrar venta (CU-05)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorRegistrarVenta" as C
participant "rt:«Singleton» RegistroTurnos" as RT
participant "cp:«Singleton» CatalogoProductos" as CP
participant "p:Producto" as P
participant "cc:«Singleton» CatalogoClientes" as CC
participant "c:Cliente" as CL
participant "t:Turno" as T

U -> C : crearNuevaVenta()
activate C
C -> RT : buscarTurnoAbierto()
activate RT
RT --> C : «t : Turno»
deactivate RT
create participant "ventaActual:Venta" as V
C -->> V : create(t : Turno, usuario : Usuario)
C --> U
deactivate C

loop más productos (1 y 2)
  opt el producto no tiene código (1.a)
    U -> C : buscarProductoPorNombre(nombre : String)
    activate C
    C -> CP : buscarPorNombre(nombre : String)
    activate CP
    CP --> C : «coincidencias : List<Producto>»
    deactivate CP
    C --> U : «coincidencias»
    deactivate C
  end
  U -> C : introducirProducto(codigo : String, cantidad : Real)
  activate C
  C -> CP : buscarProducto(codigo : String)
  activate CP
  CP --> C : «p : Producto»
  deactivate CP
  alt p = null (2.a)
    C --> U : «producto no encontrado»
  else p <> null
    C -> P : estaActivo()
    activate P
    P --> C : «activo : Boolean»
    deactivate P
    alt activo = false (2.d)
      C --> U : «producto dado de baja»
    else activo = true
      opt p se vende por kilogramo (2.c)
        C --> U : «solicitar peso»
        U -> C : ingresarPeso(kg : Real)
      end
      C -> V : agregarProducto(p : Producto, cantidad : Real)
      activate V
      create participant "lv:DetalleVenta" as LV
      V -->> LV : create(p : Producto, cantidad : Real)
      LV -> P : getPrecioVenta()
      LV -> P : getPrecioCosto()
      LV -> LV : calcularSubtotal()
      note right of LV : subtotal = cantidad * precioVenta\n(se agrega aunque no alcance el stock, 2.b)
      participant "«multiobjeto»\nlineas:DetalleVenta" as LS
      V -> LS : add(lv : DetalleVenta)
      V --> C
      deactivate V
      C --> U : «descripción + subtotal»
    end
  end
  deactivate C
  opt quita un producto o cambia la cantidad (1.b / 3.a)
    U -> C : modificarCantidad(codigo : String, cantidad : Real)
    activate C
    C -> V : modificarCantidad(p : Producto, cantidad : Real)
    C --> U : «líneas actualizadas»
    deactivate C
  end
end

alt cancela la venta (3.b)
  U -> C : cancelarVenta()
  activate C
  C -> V : cancelar()
  C --> U : «venta cancelada»
  deactivate C
else finaliza la carga (3 y 4)
  U -> C : finalizarVenta()
  activate C
  C -> V : calcularTotal()
  activate V
  V --> C : «total : Real»
  deactivate V
  C --> U : «total»
  deactivate C

  alt pago con un solo medio (5)
    U -> C : realizarPago(medio : MedioPago, importe : Real)
    C -> V : registrarPago(medio : MedioPago, importe : Real)
  else pago combinado (5.b)
    U -> C : indicarPagoCombinado()
    C --> U : «solicitar monto de cada medio»
    U -> C : realizarPagoCombinado(montoEfectivo : Real, montoTransferencia : Real)
    loop para cada medio de pago
      C -> V : registrarPago(medio : MedioPago, monto : Real)
    end
  else venta fiada (5.a)
    U -> C : indicarVentaFiada(nombre : String, apellido : String)
    C -> CC : buscarCliente(nombre : String, apellido : String)
    activate CC
    CC --> C : «c : Cliente»
    deactivate CC
    opt c = null (5.a.a)
      ref over U, C : DS-08 Gestionar clientes (alta de cliente)
    end
    C -> CL : estaHabilitado()
    activate CL
    CL --> C : «habilitado : Boolean»
    deactivate CL
  end
  activate C

  C -> V : validarPagos()
  activate V
  V --> C : «pagosValidos : Boolean»
  deactivate V
  alt venta fiada y habilitado = false (5.a.1)
    C --> U : «el cliente no está habilitado para fiado»
  else pagosValidos = false (6.a)
    C --> U : «los montos no coinciden con el total»
  else venta válida (6)
    opt venta fiada
      C -> V : asignarCliente(c : Cliente)
    end
    C -> V : confirmar()
    activate V
    loop para cada lv en lineas
      V -> P : descontarStock(cantidad : Real)
    end
    V --> C
    deactivate V
    alt venta fiada (5.a.1)
      C -> CL : cargarDeuda(total : Real)
    else venta de contado
      loop para cada medio de pago
        create participant "m:MovimientoCaja" as M
        C -->> M : create(Venta, medio : MedioPago, monto : Real, usuario : Usuario)
        C -> T : registrarMovimiento(m : MovimientoCaja)
      end
    end
    C --> U : «comprobante»
    note over U, C : si el cliente entrega dinero a cuenta de un fiado,\nse registra a continuación con el CU-07 (5.a.2)
  end
  deactivate C
end
@enduml

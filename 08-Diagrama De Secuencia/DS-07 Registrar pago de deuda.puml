@startuml
' Caso de uso de referencia: 05-Caso De Uso/CU-07 Registrar pago de deuda (fiado).md
title DS-07 — Registrar pago de deuda (CU-07)
hide footbox
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceParticipant underline

actor "empleado:Empleado" as U
participant "ctrl:ControladorPagoDeuda" as C
participant "cc:«Singleton» CatalogoClientes" as CC
participant "c:Cliente" as CL
participant "rt:«Singleton» RegistroTurnos" as RT
participant "t:Turno" as T

U -> C : buscarCliente(nombre : String, apellido : String)
activate C
C -> CC : buscarCliente(nombre : String, apellido : String)
activate CC
CC --> C : «c : Cliente»
deactivate CC
C -> CL : calcularSaldo()
activate CL
CL --> C : «saldo : Real»
deactivate CL
C --> U : «saldo adeudado»
deactivate C

alt un solo medio de pago (3)
  U -> C : registrarPago(medio : MedioPago, monto : Real)
else pago combinado (3.a)
  U -> C : indicarPagoCombinado()
  C --> U : «solicitar monto de cada medio»
  U -> C : registrarPagoCombinado(montoEfectivo : Real, montoTransferencia : Real)
end
activate C
C -> RT : buscarTurnoAbierto()
activate RT
RT --> C : «t : Turno»
deactivate RT
create participant "pf:PagoFiado" as PF
C -->> PF : create(c : Cliente, t : Turno, usuario : Usuario)
loop para cada medio de pago
  C -> PF : agregarMedioPago(medio : MedioPago, monto : Real)
end
C -> PF : validarMonto(saldo : Real)
activate PF
PF --> C : «valido : Boolean»
deactivate PF
alt valido = false (4.a)
  C --> U : «el monto supera la deuda del cliente»
else valido = true (4)
  C -> PF : registrar()
  C -> PF : calcularTotal()
  activate PF
  PF --> C : «total : Real»
  deactivate PF
  C -> CL : descontarDeuda(total : Real)
  loop para cada medio de pago
    create participant "m:MovimientoCaja" as M
    C -->> M : create(PagoFiado, medio : MedioPago, monto : Real, usuario : Usuario)
    C -> T : registrarMovimiento(m : MovimientoCaja)
  end
  C --> U : «recibo y saldo restante»
end
deactivate C
@enduml
